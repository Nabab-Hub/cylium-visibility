# Google Gemini API Key (Required for live vision detection calls)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Vision Model (e.g. gemini-3.6-flash, gemini-2.5-flash)
VISIBILITY_MODEL=gemini-3.6-flash

# Firebase Firestore Configuration (API Key validation & Usage tracking)
FIREBASE_PROJECT_ID=nude-checker
FIREBASE_CREDENTIALS=nude-checker-firebase-adminsdk.json
FIREBASE_SERVICE_ACCOUNT_JSON=
REQUIRE_FIREBASE_AUTH=true

# Microservice Security Fallback (Optional: if set and Firebase auth disabled, supply X-API-Key)
API_KEY=

# Rate Limiting & Performance
RATE_LIMIT_DEFAULT=60/minute
MAX_IMAGE_SIZE_MB=10
CACHE_TTL_SECONDS=3600
CACHE_ENABLED=true

# Server Debug Mode & Port
PORT=8003
DEBUG=false
